# Copiez ce fichier en .env (en local) ou recopiez ces variables chez l'hébergeur
# (Netlify : Site configuration > Environment variables ; Vercel : Settings > Environment Variables).

# Adresse publique du site, sans barre finale. Sert aux balises canonical, Open Graph et au sitemap.
SITE_URL=https://www.afriexport-consulting.ma

# Clé d'accès Web3Forms (https://web3forms.com). Elle est liée à l'adresse e-mail
# qui reçoit les messages du formulaire : pour changer de destinataire, générez une
# nouvelle clé avec la nouvelle adresse. Cette clé est publique par conception.
PUBLIC_WEB3FORMS_KEY=

# Aperçu pour le client : 1 = pages non indexées par Google (noindex + robots.txt fermé).
# Laisser vide pour la vraie mise en ligne.
PUBLIC_PREVIEW=

# Identifiant Google Analytics 4 (G-XXXXXXXXXX). Laisser vide pour ne rien mesurer.
# Le script n'est chargé qu'après accord du visiteur dans le bandeau cookies.
PUBLIC_GA_ID=
