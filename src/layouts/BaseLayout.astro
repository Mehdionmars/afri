---
import '@fontsource-variable/inter-tight/wght.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import PageLoader from '../components/layout/PageLoader.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import StructuredData from '../components/layout/StructuredData.astro';
import { langs, routes, useTranslations, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin de cette page dans chaque langue (balises hreflang et sélecteur FR | EN). */
  alternates: Record<Lang, string>;
  /** true sur l'accueil : le logo ramène en haut de la page. */
  isHome?: boolean;
  /** Rubrique du menu à marquer comme page courante. */
  current?: RouteKey;
  /** La page se termine par le formulaire de contact : les boutons « Contact » y mènent directement. */
  hasContact?: boolean;
  noindex?: boolean;
}

const { lang, title, description, alternates, isHome = false, current, hasContact = isHome, noindex = false } = Astro.props;
// Aperçu client (PUBLIC_PREVIEW=1) : contenus provisoires, rien ne doit être indexé.
const isPreview = import.meta.env.PUBLIC_PREVIEW === '1';
const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(alternates[lang], site).href;
const ogImage = new URL(`/og-${lang}.jpg`, site).href;
const otherLocale = lang === 'fr' ? 'en_US' : 'fr_FR';
const contactHref = hasContact ? '#contact' : `${routes.home[lang]}#contact`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Avant le premier affichage : écran de chargement (1re page de la visite),
      // puis, sur les pages suivantes, voile blanc qui se lève (src/scripts/page-transition.ts).
      (function () {
        var c = document.documentElement.classList;
        c.add('js');
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = !!sessionStorage.getItem('afx-seen'); } catch (e) {}
        if (reduce || seen) {
          c.add('no-loader');
          if (!reduce) c.add('veil');
        } else {
          c.add('is-loading');
        }
      })();
    </script>
    <!-- GSAP 3 + ScrollTrigger (cdnjs) et Lenis (jsDelivr) : scripts « defer », vérifiés par leur empreinte (SRI).
         S'ils ne chargent pas, le site reste complet, sans animation (src/scripts/site-motion.ts). -->
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js" integrity="sha512-oJ8QbaQThQoJZ7oEv+29jfPM6CcP+zUxh3PKJs1vyOhx0UraUrE7PQgeItu3dOuCJyrzWpoYMsVjkkPEBzbUqw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/ScrollTrigger.min.js" integrity="sha512-OaIE7ud4P04EhnBuhEcm0wQSceIxbi2pV03oBLS/+F6ampfxsnxcIxOp7H2eF9G7N0kEht0VAzOLG+dTLSo17Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.min.js" integrity="sha384-jqpi9VmOdhyLoLURgjCn7EpnG9BbnHW57ibIZoeaIU+erWDH3k8fQQg0xH2ySjnw" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content={isPreview ? 'noindex, nofollow' : 'noindex'} />}
    <link rel="canonical" href={canonical} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={new URL(alternates[code], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, site).href} />

    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AFRIEXPORT CONSULTING" />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={otherLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <StructuredData lang={lang} pageUrl={canonical} />
    <slot name="head" />
  </head>
  <body>
    <PageLoader lang={lang} />
    <div class="page-veil" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{t.a11y.skip}</a>
    <Header lang={lang} alternates={alternates} isHome={isHome} current={current} contactHref={contactHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} contactHref={contactHref} />
    <WhatsAppFloat lang={lang} />
    <CookieBanner lang={lang} />
  </body>
</html>

<style>
  /* Voile blanc entre deux pages : bords adoucis en haut et en bas.
     Arrivée : il couvre l'écran puis se lève vers le haut en dévoilant la page de bas en haut.
     Départ : il monte depuis le bas en s'éclaircissant de blanc, puis la page suivante s'ouvre. */
  .page-veil {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 90;
    display: none;
    height: 180vh;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0, #fff 20vh, #fff 160vh, rgba(255, 255, 255, 0) 180vh);
  }
  :global(html.veil) .page-veil {
    display: block;
    animation: afVeilUp 0.75s cubic-bezier(0.65, 0, 0.35, 1) 0.08s both;
  }
  :global(html.veil-out) .page-veil {
    display: block;
    animation: afVeilIn 0.45s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes afVeilUp {
    from {
      translate: 0 -20vh;
    }
    to {
      translate: 0 -180vh;
      visibility: hidden;
    }
  }
  @keyframes afVeilIn {
    from {
      translate: 0 100vh;
      opacity: 0;
    }
    to {
      translate: 0 -20vh;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-veil {
      display: none !important;
    }
  }

  .skip-link {
    position: fixed;
    left: 16px;
    top: 12px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: 8px;
    background: #ffc342;
    color: #0b0b0c;
    font-weight: 700;
    text-decoration: none;
    translate: 0 -200%;
    transition: translate 0.2s var(--ease-out);
  }
  .skip-link:focus {
    translate: 0 0;
    outline: 3px solid #0b0b0c;
    outline-offset: 2px;
  }
</style>

<script>
  import '../scripts/site-motion';
  import '../scripts/motion';
  import '../scripts/page-transition';
</script>
