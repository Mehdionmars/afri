---
/**
 * En-tête fixe minimal, transparent (léger flou derrière) : logo texte à gauche, menu,
 * sélecteur de langue à droite. Lien de la page courante en jaune (souligné jaune sur fond clair,
 * texte jaune sur fond sombre). Sur une section sombre, le texte passe en blanc.
 */
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { routes, useTranslations, type Lang, type RouteKey } from '../../i18n/utils';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  isHome?: boolean;
  /** Rubrique de la page courante (aria-current). */
  current?: RouteKey;
  /** '#contact' quand la page a son formulaire, sinon le formulaire de l'accueil. */
  contactHref: string;
}

const { lang, alternates, isHome = false, current, contactHref } = Astro.props;
const t = useTranslations(lang);
const home = routes.home[lang];

// Chaque rubrique a sa page ; Contact mène au formulaire de devis.
const links: { key: string; href: string; label: string }[] = [
  ...(['services', 'method', 'why', 'containers', 'results'] as const).map((key) => ({ key, href: routes[key][lang], label: t.nav[key] })),
  { key: 'contact', href: contactHref, label: t.nav.contact },
];
---

<header class="site-header on-light fixed inset-x-0 top-0 z-40 px-[max(16px,4%)]" data-header data-tone="light">
  <nav aria-label={t.a11y.mainNav} class="bar mx-auto grid h-20 max-w-wide items-center gap-3 lg:gap-6">
    <a href={isHome ? '#accueil' : home} class="logo col-start-1 flex min-w-0 items-center justify-self-start no-underline">
      <span class="logo-text whitespace-nowrap text-[17px] font-semibold tracking-[0.06em] max-[359px]:text-[15px] sm:text-[19px]">AFRIEXPORT<span class="logo-accent font-light"> CONSULTING</span><span class="sr-only">{t.a11y.home}</span></span>
    </a>

    <ul class="links col-start-2 m-0 hidden list-none items-center gap-7 p-0 min-[1180px]:flex" role="list">
      {
        links.map((link) => (
          <li>
            <a class="nav-link link-u whitespace-nowrap text-[16px] font-normal" href={link.href} aria-current={current === link.key ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="col-start-3 flex items-center gap-3 justify-self-end">
      <LanguageSwitcher lang={lang} alternates={alternates} class="hidden sm:inline-flex" />
      <button
        type="button"
        class="burger tap -mr-2 flex size-11 items-center justify-center rounded-lg min-[1180px]:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={t.a11y.menuOpen}
        data-label-close={t.a11y.menuClose}
      >
        <span class="sr-only" data-menu-label>{t.a11y.menuOpen}</span>
        <Icon name="menu" size={26} class="icon-open" />
        <Icon name="close" size={26} class="icon-close hidden" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu absolute inset-x-0 top-full border-b border-navy/8 bg-white px-[max(16px,5%)] pb-8 pt-2 shadow-[0_24px_40px_-24px_rgba(0,0,0,.25)] min-[1180px]:hidden" data-menu>
    <ul class="mx-auto flex max-w-page flex-col" role="list">
      {
        links.map((link) => (
          <li class="border-b border-metal-200">
            <a
              class="mobile-link flex min-h-14 items-center text-2xl font-light tracking-[-0.02em] text-navy no-underline"
              href={link.href}
              aria-current={current === link.key ? 'page' : undefined}
              data-menu-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mx-auto mt-6 flex max-w-page flex-wrap items-center gap-4">
      <LanguageSwitcher lang={lang} alternates={alternates} class="inline-flex sm:hidden" />
    </div>
  </div>
</header>

<style>
  /* Trois zones : logo à gauche, rubriques au centre de la page, bouton à droite. */
  .bar {
    grid-template-columns: minmax(0, 1fr) auto auto;
  }
  @media (min-width: 1180px) {
    .bar {
      grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    }
  }

  .site-header {
    background: transparent;
  }
  /* Léger flou derrière la barre, sans couleur, qui s'estompe vers le bas (pas de bord net) :
     le texte qui passe dessous reste deviné mais ne gêne plus la lecture du menu. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -12px;
    z-index: -1;
    pointer-events: none;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit-mask-image: linear-gradient(#000 65%, transparent);
    mask-image: linear-gradient(#000 65%, transparent);
  }
  /* Menu mobile ouvert : la barre devient blanche, comme le panneau. */
  .site-header[data-header][data-open] {
    background: #fff;
  }

  /* ---------- Texte sur fond clair (par défaut) ---------- */
  .logo-text,
  .logo-accent {
    color: #0f2340;
    transition: color 0.3s var(--ease-out);
  }
  .nav-link {
    color: #3f4650;
    transition: color 0.3s var(--ease-out), background-size 0.35s var(--ease-out);
  }
  .nav-link:hover {
    color: #0f2340;
  }
  /* Page courante en jaune : sur fond clair, le jaune serait illisible en texte,
     il devient un soulignement épais sous le texte bleu marine. */
  .nav-link[aria-current='page'] {
    color: #0f2340;
    background-size: 100% 3px;
    background-image: linear-gradient(#ffc342, #ffc342);
  }
  .burger {
    color: #0f2340;
  }

  /* ---------- Texte sur fond sombre (sections bleu marine ou noires) ---------- */
  [data-header][data-tone='dark']:not([data-open]) {
    --focus: #ffc342;
  }
  [data-header][data-tone='dark']:not([data-open]) .logo-text,
  [data-header][data-tone='dark']:not([data-open]) .logo-accent,
  [data-header][data-tone='dark']:not([data-open]) .nav-link:hover,
  [data-header][data-tone='dark']:not([data-open]) .burger {
    color: #fff;
  }
  /* Sur fond sombre, le lien actif est écrit en jaune. */
  [data-header][data-tone='dark']:not([data-open]) .nav-link[aria-current='page'] {
    color: #ffc342;
    background-size: 0 3px;
  }
  [data-header][data-tone='dark']:not([data-open]) .nav-link {
    color: #dde1e6;
  }
  [data-header][data-tone='dark']:not([data-open]) :global([role='group']) {
    border-color: rgba(255, 255, 255, 0.3);
    background: transparent;
  }
  [data-header][data-tone='dark']:not([data-open]) :global([data-lang-link]:not([aria-current])) {
    color: #fff;
  }
  [data-header][data-tone='dark']:not([data-open]) :global([data-lang-link][aria-current]) {
    background: #fff;
    color: #0f2340;
  }

  .mobile-link[aria-current='page'] {
    color: #0f2340;
  }
  .mobile-menu {
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out), visibility 0s linear 0.25s;
  }
  [data-header][data-open] .mobile-menu {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.25s var(--ease-out), visibility 0s;
  }
  [data-header][data-open] :global(.icon-open) {
    display: none;
  }
  [data-header][data-open] :global(.icon-close) {
    display: block;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && label) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    };

    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));

    header.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    matchMedia('(min-width: 1180px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });

    // La barre reste fixe et transparente : elle regarde la section qui passe dessous et met
    // son texte en blanc sur les fonds sombres. Rien d'autre ne bouge. Écriture seulement si ça change.
    const OVERLAYS = '[data-header], [data-route], [data-loader], [data-cookie-banner], .wa-float';
    let tone = header.dataset.tone;
    let pending = false;
    const update = () => {
      pending = false;
      // On regarde à mi-hauteur de la barre, là où se trouve son texte.
      const below = document.elementsFromPoint(innerWidth / 2, header.offsetHeight / 2).find((el) => !el.closest(OVERLAYS));
      const next = below?.closest('.on-dark, .on-light')?.classList.contains('on-dark') ? 'dark' : 'light';
      if (next !== tone) {
        tone = next;
        header.dataset.tone = tone;
      }
    };
    const schedule = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    addEventListener('load', schedule);
    update();
  }
</script>
