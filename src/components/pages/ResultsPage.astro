---
/**
 * Page « Résultats » : les quatre chiffres expliqués (chiffres FICTIFS à remplacer dans
 * src/content/site.json), trois missions types illustrées, témoignages et secteurs à fournir.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteRail from '../layout/RouteRail.astro';
import PageHero from '../sections/PageHero.astro';
import Contact from '../sections/Contact.astro';
import Icon from '../ui/Icon.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import { colon, formatNumber, routes, site, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.resultsPage;
const r = t.results;
const { stats } = site;
const pct = lang === 'fr' ? ' %' : '%';
const figures = [
  { ...r.partnerships, value: stats.partnerships, prefix: '+', suffix: '', unit: '' },
  { ...r.faster, value: stats.fasterFilesPercent, prefix: '', suffix: pct, unit: '' },
  { ...r.presence, value: stats.countries, prefix: '', suffix: '', unit: r.presence.unit },
  { ...r.growth, value: stats.growthPercent, prefix: '+', suffix: pct, unit: '' },
].map((item, i) => ({ ...item, ...p.figures[i] }));
const missionPhotos = ['mission-agro', 'mission-artisanat', 'mission-industrie'];
const ml = p.missionLabels;
---

<BaseLayout lang={lang} title={p.meta.title} description={p.meta.description} alternates={routes.results} current="results" hasContact>
  <RouteRail
    lang={lang}
    stops={[
      { id: 'intro', label: t.nav.results },
      { id: 'chiffres', label: p.figuresTitle },
      { id: 'missions', label: p.missionsTitle },
      { id: 'temoignages', label: p.testimonialsTitle },
      { id: 'secteurs', label: p.sectorsTitle },
      { id: 'contact', label: t.nav.contact },
    ]}
  />
  <PageHero lang={lang} title={p.title} lead={p.lead} photo="page-resultats" photoAlt={p.photoAlt} />

  <section id="chiffres" class="on-dark bg-navy px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="chiffres-title">
    <div class="mx-auto flex max-w-page flex-col gap-12">
      <div class="grid items-end gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
        <div class="flex flex-col gap-4">
          <h2 id="chiffres-title" class="reveal m-0 text-h2-xl text-white">{p.figuresTitle}</h2>
        </div>
        <p class="m-0 max-w-[40ch] text-lead text-metal-200 lg:justify-self-end">{p.figuresLead}</p>
      </div>
      <ul class="m-0 grid list-none gap-px overflow-hidden rounded-card p-px md:grid-cols-2" role="list" data-counters>
        {
          figures.map((item, i) => (
            <li class="reveal flex flex-col gap-5 bg-navy/50 shadow-[0_0_0_1px_rgba(255,255,255,0.1)] p-7 sm:p-9" style={`--i:${i % 2}`}>
              <p class="m-0 flex flex-wrap items-baseline gap-x-2 text-white">
                <span class="text-mega font-medium tabular-nums" data-count={item.value} data-prefix={item.prefix} data-suffix={item.suffix}>
                  {`${item.prefix}${formatNumber(lang, item.value)}${item.suffix}`}
                </span>
                {item.unit && <span class="text-h3 text-yellow">{item.unit}</span>}
              </p>
              <h3 class="m-0 text-[22px] font-medium leading-tight tracking-[-0.01em] text-white">{item.title}</h3>
              <p class="m-0 text-[16px] leading-[1.6] text-metal-200">{item.detail}</p>
              <div class="mt-auto flex flex-col gap-1.5 border-t border-white/10 pt-4">
                <p class="m-0 text-[15px] leading-[1.55] text-metal-300">
                  <strong class="font-semibold text-white">
                    {p.howLabel}
                    {colon(lang)}
                  </strong>
                  {item.how}
                </p>
                <p class="m-0 text-[13px] text-metal-300">{p.period}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="missions" class="on-light bg-white px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="missions-title">
    <div class="mx-auto flex max-w-page flex-col gap-14">
      <div class="grid items-end gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
        <div class="flex flex-col gap-4">
          <h2 id="missions-title" class="reveal m-0 text-h2-xl">{p.missionsTitle}</h2>
        </div>
        <p class="m-0 max-w-[44ch] text-lead text-metal-600 lg:justify-self-end">{p.missionsLead}</p>
      </div>
      <ol class="m-0 flex list-none flex-col gap-16 p-0 lg:gap-20" role="list">
        {
          p.missions.map((mission, i) => (
            <li class:list={['mission grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-14', i % 2 === 1 && 'flip']}>
              <figure class="reveal relative m-0 aspect-[4/3] overflow-hidden rounded-panel bg-metal-200">
                <PhotoSlot
                  photo={missionPhotos[i]}
                  alt={mission.photoAlt}
                  placeholder={`[${t.pages.photo} : ${mission.photoAlt}]`}
                  sizes="(min-width: 1240px) 560px, (min-width: 1024px) 44vw, 100vw"
                  imgClass="absolute inset-0 size-full object-cover"
                  placeholderClass="placeholder-photo absolute inset-0 text-[15px] text-metal-700"
                />
              </figure>
              <div class="flex flex-col gap-6">
                <div class="flex flex-col gap-3">
                  <p class="label-mono m-0 text-navy">{mission.sector}</p>
                  <h3 class="m-0 text-h3-xl">{mission.title}</h3>
                </div>
                <dl class="m-0 grid gap-5">
                  <div class="flex flex-col gap-1.5">
                    <dt class="label-mono text-metal-600">{ml.situation}</dt>
                    <dd class="m-0 text-[16.5px] leading-[1.6] text-metal-700">{mission.situation}</dd>
                  </div>
                  <div class="flex flex-col gap-2">
                    <dt class="label-mono text-metal-600">{ml.action}</dt>
                    <dd class="m-0">
                      <ul class="m-0 flex list-none flex-col gap-2 p-0" role="list">
                        {mission.action.map((line) => (
                          <li class="flex items-start gap-3 text-[16px] leading-[1.5] text-metal-700">
                            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-navy text-white">
                              <Icon name="check" size={11} stroke={3} />
                            </span>
                            {line}
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                  <div class="outcome flex flex-col gap-1.5 rounded-card p-5">
                    <dt class="sr-only">{ml.outcome}</dt>
                    <dd class="m-0 text-[17px] font-medium leading-snug text-ink">{mission.outcome}</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="temoignages" class="on-light bg-metal-100 px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="temoignages-title">
    <div class="mx-auto flex max-w-page flex-col gap-12">
      <h2 id="temoignages-title" class="reveal m-0 text-h2-xl">{p.testimonialsTitle}</h2>
      <ul class="m-0 grid list-none gap-5 p-0 md:grid-cols-2" role="list">
        {
          p.testimonials.map((quote, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <figure class="m-0 flex h-full flex-col gap-6 rounded-panel bg-white p-7 sm:p-9">
                <Icon name="quote" size={34} stroke={1.6} class="text-navy" />
                <blockquote class="m-0 text-[clamp(1.125rem,1rem+0.4vw,1.375rem)] leading-[1.5] text-ink">{quote.quote}</blockquote>
                <figcaption class="mt-auto flex flex-col gap-0.5 border-t border-navy/10 pt-4">
                  <span class="text-[16px] font-semibold">{quote.name}</span>
                  <span class="text-[14.5px] text-metal-600">{quote.company}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="secteurs" class="on-light bg-white px-[max(16px,5%)] py-20 sm:py-24" aria-labelledby="secteurs-title">
    <div class="mx-auto grid max-w-page items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
      <div class="flex flex-col gap-3">
        <h2 id="secteurs-title" class="reveal m-0 text-h2-lg">{p.sectorsTitle}</h2>
        <p class="m-0 text-[13.5px] text-metal-600">{p.sectorsNote}</p>
      </div>
      <ul class="m-0 flex list-none flex-wrap gap-3 p-0" role="list">
        {
          p.sectors.map((sector, i) => (
            <li class="sector reveal" style={`--i:${i % 4}`}>
              {sector}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Contact lang={lang} />
</BaseLayout>

<style>
  @media (min-width: 1024px) {
    .mission.flip > figure {
      order: 2;
    }
  }
  .outcome {
    background: #eef0f2;
  }
  .sector {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 20px;
    border-radius: 999px;
    background: #eef0f2;
    font-size: 17px;
    font-weight: 600;
    color: #0b0b0c;
  }
</style>

<script>
  // Les compteurs montent jusqu'à leur valeur à l'arrivée (directement affichés avec mouvement réduit).
  const list = document.querySelector<HTMLElement>('[data-counters]');
  if (list && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const counters = [...list.querySelectorAll<HTMLElement>('[data-count]')];
    const locale = document.documentElement.lang === 'fr' ? 'fr-FR' : 'en-GB';
    const write = (el: HTMLElement, n: number) => {
      el.textContent = `${el.dataset.prefix ?? ''}${new Intl.NumberFormat(locale).format(n)}${el.dataset.suffix ?? ''}`;
    };
    if (list.getBoundingClientRect().top > innerHeight) {
      counters.forEach((el) => write(el, 0));
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          const start = performance.now();
          const step = (now: number) => {
            const k = Math.min(1, (now - start) / 1400);
            counters.forEach((el) => write(el, Math.round(Number(el.dataset.count) * (1 - Math.pow(1 - k, 3)))));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        },
        { threshold: 0.25 },
      );
      observer.observe(list);
    }
  }
</script>
