---
/**
 * Scène d'accueil dessinée en CSS et SVG : ciel de plein jour, parc à conteneurs
 * (proportions réelles 20 et 40 pieds) et le conteneur jaune AFRIEXPORT qui descend,
 * pivote pour se présenter de face et se range dans la place vide, comme ses voisins.
 * - Ordinateur : la descente suit le scroll (src/scripts/hero-scrub.ts).
 * - Téléphone et tablette : il descend tout seul à l'entrée de la page.
 * - Mouvement réduit ou sans JavaScript : il est déjà à sa place.
 * Le script calcule la position et la taille exactes de la place vide (--hang-x,
 * --land-y, --hang-scale) ; les valeurs CSS ci-dessous ne servent que de repli.
 * Entièrement décorative.
 */
import Container3D from './Container3D.astro';
import ContainerScene from './ContainerScene.astro';

// Côté gauche (derrière les textes) : conteneurs clairs ; les bleu marine sont à droite.
// Parc vu de face. Rangée de 92 unités ; un 20 pieds fait 214 de large, un 40 pieds 428
// (rapport réel longueur / hauteur d'un conteneur). [x, pieds, rangée (0 = sol), couleur]
const W = 1440;
const H = 92;
const FT = { 20: 214, 40: 428 } as const;
// Couleurs de la charte : bleu marine, gris métal (clair et foncé).
const palette = { a: '#0F2340', b: '#8B949E', c: '#B8C0C9', d: '#DDE1E6', e: '#1B3459', f: '#5E6670' };
type Box = [number, 20 | 40, number, keyof typeof palette];
const boxes: Box[] = [
  [-100, 40, 0, 'a'], [328, 20, 0, 'd'], [542, 40, 0, 'e'], [970, 20, 0, 'c'], [1184, 40, 0, 'b'],
  [-40, 20, 1, 'c'], [174, 40, 1, 'b'], [602, 20, 1, 'f'], [1030, 40, 1, 'e'],
  [60, 40, 2, 'd'], [488, 20, 2, 'c'], [1180, 20, 2, 'a'],
];
// La place vide : rangée 1, de 816 à 1030 (un 20 pieds), soit environ 64 % de la largeur.
const SLOT_X = 816;
const groundY = 420;
---

<div class="scene-root" aria-hidden="true" data-scene>
  <div class="sky"></div>
  <div class="haze"></div>
  <div class="dust" data-anim></div>

  <svg class="yard" viewBox={`0 0 ${W} ${groundY + 20}`} preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <pattern id="ribs" width="11" height="10" patternUnits="userSpaceOnUse">
        <rect width="11" height="10" fill="transparent" />
        <rect x="8" width="3" height="10" fill="rgba(0,0,0,.14)" />
      </pattern>
    </defs>
    {
      boxes.map(([x, ft, row, c]) => {
        const y = groundY - H * (row + 1);
        const w = FT[ft];
        return (
          <g>
            <rect x={x} y={y} width={w - 4} height={H - 4} rx="2" fill={palette[c]} />
            <rect x={x} y={y} width={w - 4} height={H - 4} rx="2" fill="url(#ribs)" />
            <rect x={x} y={y} width={w - 4} height="6" fill="rgba(255,255,255,.18)" />
          </g>
        );
      })
    }
    <!-- La place vide (dimensions exactes d'un 20 pieds) : sert de repère au script. -->
    <rect x={SLOT_X} y={groundY - 2 * H} width={FT[20] - 4} height={H - 4} fill="none" data-slot />
    <!-- Marquage jaune au sol de la place : s'illumine à l'atterrissage. -->
    <rect class="slot-mark" x={SLOT_X} y={groundY - H - 4} width={FT[20] - 4} height="4" fill="#FFC342" />
    <rect x="0" y={groundY} width={W} height="20" fill="#0B0B0C" />
  </svg>

  <!-- Point d'ancrage de taille nulle : le câble et le conteneur suivent ses déplacements. -->
  <div class="anchor" data-anchor>
    <div class="cable"></div>
    <div class="puff"></div>
    <div class="rig-box" data-anim>
      <ContainerScene animation="none" startAngle={0} tilt={0} perspective={1200} pausable={false} class="absolute inset-0" rigClass="hang-rig">
        <Container3D length={6.06} width={2.44} height={2.59} color="yellow" scale={26} branded />
      </ContainerScene>
    </div>
  </div>
</div>

<style>
  .scene-root {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #eef0f2;
    /* Pose finale par défaut : de face, posé (le script affine la position). */
    --turn: 0;
    --sway: 0;
    --land: 1;
    --hang-x: 64%;
    --hang-scale: 0.6;
    --cable-h: 110px;
  }
  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #dde1e6 0%, #eef0f2 48%, #f5f6f8 100%);
  }
  .haze {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 45% at 80% 12%, rgba(255, 255, 255, 0.85), transparent 70%);
  }
  /* Poussière lumineuse très lente, à peine visible. */
  .dust {
    position: absolute;
    inset: -60px;
    opacity: 0.6;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.9) 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 70% 20%, rgba(255, 255, 255, 0.8) 0 1px, transparent 2px),
      radial-gradient(circle at 45% 60%, rgba(255, 255, 255, 0.9) 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 85% 50%, rgba(255, 255, 255, 0.7) 0 1px, transparent 2px);
    background-size: 340px 260px, 280px 300px, 420px 360px, 380px 240px;
    animation: afDrift 70s linear -12s infinite alternate;
  }
  .yard {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 230px;
  }
  .slot-mark {
    opacity: calc(0.55 + 0.45 * var(--land));
  }

  .anchor {
    position: absolute;
    left: var(--hang-x);
    top: var(--land-y, calc(100% - 72px));
    width: 0;
    height: 0;
  }
  /* Le câble part du haut du conteneur ; il se détache (s'efface) à l'atterrissage. */
  .cable {
    position: absolute;
    left: -1px;
    bottom: calc(34px * var(--hang-scale));
    width: 2px;
    height: var(--cable-h);
    background: linear-gradient(rgba(15, 35, 64, 0), #0b0b0c 45%);
    opacity: calc(1 - var(--land));
  }
  :global(.hang-rig) {
    scale: var(--hang-scale);
    animation: afHang 7s ease-in-out -2s infinite;
  }
  /* Petit nuage de poussière à l'atterrissage (mode défilement). */
  .puff {
    position: absolute;
    left: 0;
    top: calc(34px * var(--hang-scale));
    width: calc(260px * var(--hang-scale));
    height: 36px;
    translate: -50% -40%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(221, 225, 230, 0.6) 55%, transparent);
    filter: blur(2px);
    opacity: var(--puff, 0);
    scale: calc(0.6 + 0.8 * var(--puff-grow, 0));
    pointer-events: none;
  }

  /* Entrée de l'accueil (téléphone, tablette) : quand le parc arrive à l'écran, le conteneur
     descend en 3D, pivote et se range. Il attend hors champ jusque-là.
     Sans JavaScript, il est simplement déjà à sa place. */
  :global(html.hero-intro .hero:not(.is-scene)) .scene-root:not(.is-seen) .anchor {
    translate: 0 -70vh;
  }
  :global(html.hero-intro .hero:not(.is-scene)) .scene-root.is-seen .anchor {
    animation: afDrop 2.2s cubic-bezier(0.25, 0.7, 0.25, 1) 0.15s both;
  }
  @keyframes afDrop {
    0% {
      translate: 0 -70vh;
      --turn: 1;
      --sway: 1;
      --land: 0;
    }
    55% {
      --turn: 1;
      --sway: 0.8;
    }
    88% {
      --land: 0;
    }
    100% {
      translate: 0 0;
      --turn: 0;
      --sway: 0;
      --land: 1;
    }
  }

  @media (min-width: 640px) {
    .yard {
      height: 270px;
    }
  }
  @media (min-width: 1024px) {
    .scene-root {
      --hang-scale: 1.3;
      --cable-h: 130vh;
    }
    .yard {
      height: 40%;
    }
    .cable {
      background: #0b0b0c;
    }
  }

  /* Mode défilement (ordinateur) : le script pilote la descente (--y), la rotation, l'atterrissage. */
  :global(.hero.is-scene) .anchor {
    top: 0;
    animation: none;
    translate: none;
    transform: translateY(var(--y, 0px));
  }
  /* La barre de navigation est fixe et transparente : le câble naît juste sous elle, en fondu. */
  :global(.hero.is-scene) .cable {
    height: max(0px, calc(var(--y, 0px) - 34px * var(--hang-scale) - var(--header-h) - 12px));
    background: linear-gradient(rgba(11, 11, 12, 0), #0b0b0c 48px);
  }
</style>
