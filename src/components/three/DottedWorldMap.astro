---
import { MOROCCO_PATH, WORLD_VIEWBOX } from '../../data/world-dots';

interface Props {
  class?: string;
  /** Halo lumineux qui respire doucement sur le Maroc. */
  pulse?: boolean;
  preserveAspectRatio?: string;
}

const { class: className, pulse = false, preserveAspectRatio = 'xMidYMid meet' } = Astro.props;
---

<svg class={className} viewBox={WORLD_VIEWBOX} preserveAspectRatio={preserveAspectRatio} aria-hidden="true" focusable="false">
  <use href="#world-dots"></use>
  {pulse && <path class="pulse" d={MOROCCO_PATH} fill="none" stroke="#FFC342" stroke-width="11" stroke-linecap="round" />}
</svg>

<style>
  .pulse {
    opacity: 0.15;
    animation: afPulse 4.5s ease-in-out -1.2s infinite;
  }
</style>
