---
/**
 * Conteneurs (accueil) : le moment interactif du site. Le visiteur choisit un format,
 * le conteneur 3D s'allonge ou se rehausse en direct et les chiffres défilent.
 * Le guide complet (familles, comparateur, calculateur, états) est sur la page Conteneurs.
 */
import ContainerPicker from '../containers/ContainerPicker.astro';
import { formatNumber, routes, site, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.containers;
const specs = site.containers.map((spec) => ({
  ...spec,
  label: spec.name.replace('Standard ', '').replace('High Cube ', ''),
  type: t.types[spec.id as keyof typeof t.types],
}));

const fields = [
  { key: 'lengthM', label: t.length, digits: 2, unit: 'm' },
  { key: 'widthM', label: t.width, digits: 2, unit: 'm' },
  { key: 'heightM', label: t.height, digits: 2, unit: 'm' },
  { key: 'volumeM3', label: t.volume, digits: 1, unit: 'm³', approx: true },
  { key: 'payloadKg', label: t.payload, digits: 0, unit: 'kg', approx: true },
  { key: 'palletsEuro', label: t.pallets, digits: 0, unit: '' },
] as const;

const fmt = (value: number, digits: number, unit: string, approx = false) =>
  `${approx ? '≈ ' : ''}${formatNumber(lang, value, digits)}${unit ? ` ${unit}` : ''}`;
---

<section id="conteneurs" class="on-light bg-white px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="conteneurs-title">
  <div class="mx-auto flex max-w-page flex-col gap-12">
    <div class="grid items-end gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
      <div class="flex flex-col gap-4">
        <h2 id="conteneurs-title" class="reveal m-0 max-w-[18ch] text-h2-xl">{t.title}</h2>
      </div>
      <div class="flex flex-col gap-4 lg:justify-self-end">
        <p class="m-0 max-w-[42ch] text-lead text-metal-600">{t.lead}</p>
        <a href={routes.containers[lang]} class="link-u self-start text-base font-semibold text-ink">{all.pages.homeLinks.containers} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ContainerPicker lang={lang} specs={specs} />

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)] lg:items-start">
      <div class="flex flex-col gap-3">
        <h3 class="reveal m-0 text-h3-lg">{t.conditionsTitle}</h3>
        <a href={`${routes.containers[lang]}#etats`} class="link-u self-start text-[15px] font-semibold text-ink">{all.containersPage.checklistTitle} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-4" role="list">
        {
          t.conditions.map((condition, i) => (
            <li class:list={['reveal lift flex flex-col gap-2 rounded-card p-6', i < 2 ? 'bg-yellow' : 'bg-metal-100']} style={`--i:${i}`}>
              <h4 class="m-0 text-[19px] font-medium tracking-[-0.01em]">{condition.title}</h4>
              <p class:list={['m-0 text-[15px] leading-[1.55]', i < 2 ? 'text-ink' : 'text-metal-600']}>{condition.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <details class="compare rounded-card border border-navy/12 bg-metal-100">
      <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-6 text-[15px] font-semibold">
        {t.compare}
        <span class="label-mono text-metal-600" aria-hidden="true">+</span>
      </summary>
      <div class="overflow-x-auto px-6 pb-6">
        <table class="w-full min-w-[560px] border-collapse text-left text-[15px]">
          <thead>
            <tr>
              <th scope="col" class="label-mono py-3 pr-4 font-medium text-metal-600">{t.format}</th>
              {fields.map((field) => <th scope="col" class="label-mono py-3 pr-4 font-medium text-metal-600">{field.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              site.containers.map((spec) => (
                <tr class="border-t border-navy/10">
                  <th scope="row" class="py-3 pr-4 font-semibold">{spec.name}</th>
                  {fields.map((field) => <td class="py-3 pr-4 tabular-nums">{fmt(spec[field.key], field.digits, field.unit, 'approx' in field)}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
        <a href={`${routes.containers[lang]}#comparateur`} class="link-u mt-5 inline-block text-[15px] font-semibold text-ink">{all.containersPage.compareTitle} <span aria-hidden="true">→</span></a>
      </div>
    </details>
  </div>
</section>

<style>
  .compare summary {
    list-style: none;
  }
  .compare summary::-webkit-details-marker {
    display: none;
  }
  .compare[open] summary span {
    rotate: 45deg;
  }
</style>
