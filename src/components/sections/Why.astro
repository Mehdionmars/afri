---
import CheckItem from '../ui/CheckItem.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import { formatPercent, routes, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.why;
---

<section id="pourquoi" class="on-light bg-metal-100 px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="pourquoi-title">
  <div class="mx-auto grid max-w-page items-stretch gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-20">
    <div class="reveal relative min-h-[340px] overflow-hidden rounded-panel bg-metal-200 sm:min-h-[520px]">
      <PhotoSlot
        photo="pourquoi"
        alt={t.photoAlt}
        placeholder={t.photo}
        sizes="(min-width: 1024px) 600px, 100vw"
        imgClass="absolute inset-0 size-full object-cover"
        placeholderClass="placeholder-photo absolute inset-0 text-[15px] text-metal-700"
      />
    </div>

    <div class="flex flex-col justify-center gap-8">
      <div class="flex flex-col gap-4">
        <h2 id="pourquoi-title" class="reveal m-0 text-h2-lg">{t.title}</h2>
      </div>

      <figure class="reveal m-0 flex flex-col gap-3 border-l-4 border-yellow bg-white px-6 py-5">
        <p class="m-0 flex flex-wrap items-baseline gap-x-3">
          <span class="text-[clamp(3rem,2.4rem+2vw,4.25rem)] font-medium leading-none tracking-[-0.04em]">{formatPercent(lang, t.stat.value)}</span>
          <span class="max-w-[30ch] text-[17px] leading-snug text-ink">{t.stat.text}</span>
        </p>
        <p class="m-0 text-[15px] font-semibold text-ink">{t.stat.follow}</p>
        <figcaption class="label-mono text-metal-600">{t.stat.source}</figcaption>
      </figure>

      <ul class="m-0 flex list-none flex-col gap-[22px] p-0" role="list">
        {t.reasons.map((reason, i) => <CheckItem title={reason.title} text={reason.text} index={i} />)}
      </ul>
      <a href={routes.why[lang]} class="link-u self-start text-base font-semibold text-ink">{all.pages.homeLinks.why} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
