---
/**
 * Pourquoi nous (accueil) : adaptée du composant « Bold Stats » de 21st.dev (uilayout.contact).
 * Le chiffre clé en très grand avec sa phrase, la photo du port à côté, puis un filet
 * et les quatre arguments du client sur une ligne. Sous 1024 px : tout s'empile.
 */
import PhotoSlot from '../ui/PhotoSlot.astro';
import { formatPercent, routes, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.why;
// Espace fine insécable avant « % » : le chiffre ne se coupe jamais, même en très grand.
const value = formatPercent(lang, t.stat.value).replace(' ', ' ');
---

<section id="pourquoi" class="on-light bg-metal-100 px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="pourquoi-title">
  <div class="mx-auto flex max-w-page flex-col gap-12 lg:gap-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="pourquoi-title" class="reveal m-0 max-w-[20ch] text-h2-xl">{t.title}</h2>
      <a href={routes.why[lang]} class="link-u text-base font-semibold text-ink">{all.pages.homeLinks.why} <span aria-hidden="true">→</span></a>
    </div>

    <div class="lead">
      <figure class="stat m-0">
        <p class="stat-line m-0">
          <span class="stat-value">{value}</span>
          <span class="stat-copy">
            <span class="stat-text">{t.stat.text}</span>
            <span class="stat-follow">{t.stat.follow}</span>
          </span>
        </p>
        <figcaption class="label-mono stat-source text-metal-600">{t.stat.source}</figcaption>
      </figure>

      <div class="photo">
        <PhotoSlot
          photo="pourquoi"
          alt={t.photoAlt}
          placeholder={t.photo}
          sizes="(min-width: 1024px) 520px, 100vw"
          widths={[480, 800, 1200]}
          imgClass="absolute inset-0 size-full object-cover"
          placeholderClass="placeholder-photo absolute inset-0 text-[15px] text-metal-700"
        />
      </div>
    </div>

    <ul class="reasons m-0 list-none p-0" role="list">
      {
        t.reasons.map((reason) => (
          <li class="reason">
            <h3 class="reason-title">{reason.title}</h3>
            <p class="reason-text">{reason.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- Chiffre clé et photo ---------- */
  .lead {
    display: grid;
    gap: 40px;
  }
  .stat-line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px 28px;
  }
  .stat-value {
    font-size: clamp(5.5rem, 3.2rem + 8vw, 10rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: #0b0b0c;
  }
  .stat-copy {
    display: flex;
    flex: 1 1 220px;
    flex-direction: column;
    gap: 8px;
    max-width: 300px;
  }
  .stat-text {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #0b0b0c;
  }
  .stat-follow {
    font-size: 17px;
    line-height: 1.45;
    color: #5e6670;
  }
  .stat-source {
    display: block;
    margin-top: 28px;
  }
  .photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: 20px;
    background: #dde1e6;
  }

  /* ---------- Les quatre arguments, sous un filet ---------- */
  .reasons {
    display: grid;
    gap: 32px;
    padding-top: 40px;
    border-top: 1px solid rgba(15, 35, 64, 0.15);
  }
  .reason-title {
    margin: 0 0 10px;
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .reason-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: #5e6670;
  }

  @media (min-width: 640px) {
    .reasons {
      grid-template-columns: 1fr 1fr;
      gap: 40px 48px;
    }
  }

  /* ---------- Ordinateur : chiffre à gauche, photo à droite, arguments sur une ligne ---------- */
  @media (min-width: 1024px) {
    .lead {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
    }
    .photo {
      aspect-ratio: 16 / 10;
    }
    .reasons {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px;
      padding-top: 48px;
    }
  }
</style>
