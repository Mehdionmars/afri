---
/**
 * Accueil cinématique. Sur ordinateur, la vidéo avance quand on descend et
 * recule quand on remonte (moteur : src/scripts/hero-scrub.ts). Sur téléphone,
 * avec mouvement réduit ou sans vidéo configurée : accueil fixe sur la scène
 * dessinée (ou sur l'image de fin du film quand elle existe).
 * Vidéo : src/content/site.json > heroVideo.
 */
import Button from '../ui/Button.astro';
import HeroScene from '../three/HeroScene.astro';
import { site, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).hero;
const video = site.heroVideo;
const hasVideo = Boolean(video.src);
---

<section
  id="accueil"
  class="hero on-light"
  aria-labelledby="hero-title"
  data-hero
  data-video={hasVideo ? video.src : undefined}
  data-poster={video.poster || undefined}
  data-bytes={video.bytes || undefined}
  style={video.ending ? `--ending:url('${video.ending}')` : undefined}
>
  <div class="stage" data-stage>
    <div class="media" aria-hidden="true">
      <HeroScene />
      {video.ending && <div class="ending-still"></div>}
      <div class="poster" data-poster-layer></div>
      {hasVideo && <video preload="none" muted playsinline disablepictureinpicture tabindex="-1" aria-hidden="true" data-hero-video></video>}
      <div class="base-scrim"></div>
    </div>

    <p class="sr-only">{t.bands.join(' ')}</p>

    <div class="band band-1" data-band data-a="0" data-b="0.28" data-first aria-hidden="true">
      <p class="hook">{t.bands[0]}</p>
    </div>
    <div class="band band-2" data-band data-a="0.34" data-b="0.62" aria-hidden="true">
      <p class="hook">{t.bands[1]}</p>
    </div>

    <div class="band band-settle" data-band data-a="0.70" data-b="1" data-last data-ramp="0.06">
      <div class="settle-inner">
        <h1 id="hero-title" class="settle-title m-0 text-display">{t.title}</h1>
        <p class="settle-lead m-0 text-lead">{t.lead}</p>
        <div class="settle-ctas flex flex-wrap gap-3.5">
          <Button href="#contact" size="lg">{t.ctaPrimary}</Button>
          <Button href="#services" size="lg" variant="ghost">{t.ctaSecondary}</Button>
        </div>
      </div>
    </div>

    <div class="cue" aria-hidden="true" data-cue>
      <svg class="ring" viewBox="0 0 48 48" focusable="false">
        <circle cx="24" cy="24" r="20" fill="none" stroke="rgba(15, 35, 64,.15)" stroke-width="3"></circle>
        <circle class="ring-fill" cx="24" cy="24" r="20" fill="none" stroke="#0B0B0C" stroke-width="3" stroke-dasharray="126" stroke-linecap="round"></circle>
      </svg>
    </div>
  </div>
</section>

<style>
  /* ---------- Accueil fixe (par défaut) ---------- */
  /* La barre de navigation est fixe et transparente : l'accueil commence tout en haut, sous elle. */
  .hero {
    position: relative;
  }
  .stage {
    position: relative;
    min-height: max(640px, 100svh);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .ending-still,
  .poster {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .ending-still {
    background-image: var(--ending);
  }
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: translateZ(0);
    transition: opacity 0.6s var(--ease-out);
  }
  .base-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.45) 38%, rgba(255, 255, 255, 0) 62%);
  }
  .band-1,
  .band-2,
  .cue {
    display: none;
  }
  .band-settle {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: calc(var(--header-h) + 40px) max(16px, 5%) 56px;
  }
  .settle-inner {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .settle-title {
    max-width: 15ch;
    color: #0b0b0c;
  }
  .settle-lead {
    max-width: 34rem;
    color: #3F4650;
  }
  /* Téléphone et tablette : texte en haut, scène dessinée en dessous. */
  @media (max-width: 1023px) {
    .stage {
      align-items: flex-start;
      min-height: max(720px, 100svh);
    }
    .band-settle {
      padding-bottom: 330px;
    }
    .base-scrim {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.6) 40%, rgba(255, 255, 255, 0) 60%);
    }
  }

  /* ---------- Mode défilement vidéo (ajouté par le script) ---------- */
  .hero.is-scrub {
    height: 400vh;
  }
  /* Sans vidéo, la scène dessinée joue le film sur une course plus courte. */
  .hero.is-scrub.scene-only {
    height: 300vh;
  }
  .hero.scene-only .band-2 {
    left: max(24px, 6vw);
    right: auto;
    text-align: left;
  }
  /* Les voiles servent à lire du texte sur une vidéo ; la scène dessinée est calme :
     un dégradé à gauche suffit, et le conteneur garde ses couleurs. */
  .hero.is-scrub.scene-only .base-scrim {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.5) 38%, rgba(255, 255, 255, 0) 58%);
  }
  .hero.scene-only .band::before {
    display: none;
  }
  .hero.is-scrub .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 0;
  }
  .hero.is-scrub .base-scrim {
    background: radial-gradient(ellipse 120% 90% at 50% 45%, rgba(255, 255, 255, 0) 45%, rgba(255, 255, 255, 0.35) 100%);
  }
  .hero.video-ready video {
    opacity: 1;
  }
  .hero.is-scrub .band {
    display: block;
    position: absolute;
    z-index: 2;
    opacity: 0;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95), 0 4px 18px rgba(255, 255, 255, 0.85), 0 10px 44px rgba(255, 255, 255, 0.8);
  }
  .hero.is-scrub .band :global(.btn) {
    text-shadow: none;
  }
  /* Voile clair propre à chaque bande, qui s'intensifie avec elle. */
  .hero.is-scrub .band::before {
    content: '';
    position: absolute;
    inset: -12% -10%;
    z-index: -1;
    pointer-events: none;
    opacity: calc(0.25 + 0.75 * var(--k, 1));
    background: radial-gradient(ellipse 74% 62% at 50% 50%, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.55) 46%, rgba(255, 255, 255, 0) 76%);
  }
  .hook {
    margin: 0;
    max-width: 9em;
    font-size: clamp(2.5rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 500;
    color: #0b0b0c;
  }
  .hero.is-scrub .band-1 {
    left: max(24px, 6vw);
    top: 50%;
    translate: 0 -50%;
  }
  .hero.is-scrub .band-2 {
    right: max(24px, 6vw);
    top: 50%;
    translate: 0 -50%;
    text-align: right;
  }
  .hero.is-scrub .band-settle {
    inset: 0;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }

  /* Entrées, pilotées par --k (0 à 1) que le script écrit sur chaque bande. */
  .band-1 :global(.w) {
    --kc: clamp(0, (var(--k, 1) - var(--th, 0)) * 2.8, 1);
    display: inline-block;
    opacity: var(--kc);
    translate: 0 calc((1 - var(--kc)) * -26px);
  }
  .band-2 :global(.w) {
    --kc: clamp(0, (var(--k, 1) - var(--th, 0)) * 3, 1);
    --ks: clamp(0, (var(--k, 1) - var(--th, 0) - 0.12) * 3, 1);
    display: inline-block;
    opacity: var(--kc);
    scale: calc(0.6 + 0.52 * var(--kc) - 0.12 * var(--ks));
  }
  .band-settle :global(.w) {
    --kc: clamp(0, (var(--k, 1) - var(--th, 0)) * 3, 1);
    display: inline-block;
    opacity: var(--kc);
    translate: 0 calc((1 - var(--kc)) * 28px);
  }
  .hero.is-scrub .settle-lead {
    opacity: clamp(0, (var(--k, 1) - 0.62) * 4, 1);
  }
  .hero.is-scrub .settle-ctas {
    opacity: clamp(0, (var(--k, 1) - 0.76) * 5, 1);
    translate: 0 calc((1 - clamp(0, (var(--k, 1) - 0.76) * 5, 1)) * 12px);
  }

  /* Anneau de chargement de la vidéo : seulement quand une vidéo d'accueil est branchée. */
  .hero.is-scrub .cue {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: flex;
    transition: opacity 0.4s var(--ease-out);
  }
  .hero.scene-only .cue {
    display: none;
  }
  .ring {
    width: 44px;
    height: 44px;
    rotate: -90deg;
  }
  .ring-fill {
    stroke-dashoffset: var(--ld, 126);
  }
  .hero.video-ready .cue,
  .hero.video-failed .cue,
  .hero.is-past-start .cue {
    opacity: 0;
  }
  @media (max-height: 560px) {
    .hero.is-scrub .cue {
      display: none;
    }
  }

  /* Les cinq conditions de l'accueil fixe, identiques à celles du script.
     Filet de sécurité : même si le script n'a pas encore réagi, la mise en page reste fixe. */
  @media (max-width: 720px), (orientation: portrait) and (max-width: 1024px), (orientation: portrait) and (pointer: coarse), (orientation: landscape) and (pointer: coarse) and (max-height: 560px), (prefers-reduced-motion: reduce) {
    .hero.is-scrub {
      height: auto;
    }
    .hero.is-scrub .stage {
      position: relative;
      height: auto;
      min-height: max(720px, 100svh);
    }
    .hero.is-scrub .band-1,
    .hero.is-scrub .band-2,
    .hero.is-scrub .cue {
      display: none;
    }
  }
</style>

<script>
  import { initHeroScrub } from '../../scripts/hero-scrub';
  initHeroScrub();
</script>
