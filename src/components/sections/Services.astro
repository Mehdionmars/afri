---
/**
 * Services (accueil) : galerie en accordéon, adaptée du composant « Hover Expand Gallery »
 * de 21st.dev (kedhareswer). Six bandes séparées par un filet, le nom du service écrit à
 * l'horizontale ; la bande survolée (ou touchée, ou atteinte au clavier) s'ouvre sur la photo
 * du service, avec son nom, sa description et le lien vers sa page. Sous 1280 px : accordéon vertical.
 */
import Icon from '../ui/Icon.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import { routes, serviceIds, serviceRoute, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.services;
const items = t.items.map((item, i) => {
  const id = serviceIds[i];
  return { ...item, href: serviceRoute(id)[lang], summary: all.serviceSummaries[id], alt: all.serviceDetails[id].photoAlt };
});
---

<section id="services" class="on-light bg-metal-100 px-[max(16px,5%)] py-20 sm:py-28" aria-labelledby="services-title">
  <div class="mx-auto flex max-w-page flex-col gap-12 lg:gap-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-4">
        <h2 id="services-title" class="reveal m-0 text-h2-xl">{t.title}</h2>
        <p class="m-0 text-lead text-metal-600">{t.subtitle}</p>
      </div>
      <a href={routes.services[lang]} class="link-u text-base font-semibold text-ink">{all.pages.homeLinks.services} <span aria-hidden="true">→</span></a>
    </div>

    <ul class="hx m-0 list-none p-0" role="list" style={`--n:${items.length}`} data-hx>
      {
        items.map((item, i) => (
          <li class:list={['hx-item', i === 0 && 'is-active']} data-hx-item>
            <h3 class="hx-head">
              <button type="button" class="hx-rail" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`hx-${item.id}`}>
                <span class="hx-title">{item.title}</span>
                <span class="hx-icon" aria-hidden="true">
                  <Icon name="plus" size={18} stroke={2} />
                </span>
              </button>
            </h3>
            <a id={`hx-${item.id}`} href={item.href} class="hx-media" inert={i === 0 ? undefined : true}>
              <PhotoSlot
                photo={`services-${item.id}`}
                alt={item.alt}
                placeholder={item.photo}
                sizes="(min-width: 1280px) 560px, 100vw"
                widths={[480, 800, 1200]}
                imgClass="hx-img absolute inset-0 size-full object-cover"
                placeholderClass="placeholder-photo absolute inset-0 text-[15px] text-metal-700"
              />
              <span class="hx-shade" aria-hidden="true" />
              <span class="hx-copy">
                <span class="hx-name" aria-hidden="true">
                  {item.title}
                </span>
                <span class="hx-summary">{item.summary}</span>
                <span class="hx-cta">
                  {all.pages.homeLinks.service}
                  <Icon name="arrow" size={18} stroke={2.2} />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hx {
    --rail: 150px;
    --t: 620ms;
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    border-top: 1px solid rgba(15, 35, 64, 0.15);
    border-bottom: 1px solid rgba(15, 35, 64, 0.15);
  }

  /* ---------- Téléphone et tablette : accordéon vertical ---------- */
  .hx-item + .hx-item {
    border-top: 1px solid rgba(15, 35, 64, 0.15);
  }
  .hx-head {
    margin: 0;
    font: inherit;
  }
  .hx-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 68px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: #5e6670;
    text-align: left;
    cursor: pointer;
    transition: color var(--t) ease-out;
  }
  .hx-title {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .hx-rail:hover,
  .is-active .hx-rail {
    color: #0b0b0c;
  }
  .hx-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(15, 35, 64, 0.2);
    transition: rotate var(--t) var(--ease), background-color var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .is-active .hx-icon {
    rotate: 45deg;
    background: #ffc342;
    box-shadow: none;
  }
  .hx-rail:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .hx-media {
    position: relative;
    display: block;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    opacity: 0;
    color: #fff;
    text-decoration: none;
    transition: height var(--t) var(--ease), opacity var(--t) var(--ease), margin var(--t) var(--ease);
  }
  .is-active .hx-media {
    height: 300px;
    margin-bottom: 20px;
    opacity: 1;
  }
  .hx-media :global(.hx-img) {
    transition: scale 0.9s var(--ease);
  }
  .hx-media:hover :global(.hx-img) {
    scale: 1.04;
  }
  /* Voile noir et bleu marine en bas de la photo, pour lire le texte. */
  .hx-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(11, 11, 12, 0.82) 0%, rgba(15, 35, 64, 0.45) 45%, rgba(15, 35, 64, 0) 75%);
  }
  .hx-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 22px;
  }
  .hx-name {
    display: none;
  }
  .hx-summary {
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.5;
  }
  .hx-cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 8px;
    background: #ffc342;
    color: #0b0b0c;
    font-size: 15px;
    font-weight: 700;
  }
  .hx-media:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  /* ---------- Ordinateur (≥ 1280 px) : bandes côte à côte, textes à l'horizontale ---------- */
  @media (min-width: 1280px) {
    .hx {
      display: flex;
      height: clamp(520px, 64vh, 600px);
      border-bottom: 0;
      border-top: 0;
    }
    .hx-item {
      position: relative;
      min-width: 0;
      flex: 0 1 var(--rail);
      overflow: hidden;
      border-left: 1px solid rgba(15, 35, 64, 0.15);
      transition: flex-basis var(--t) var(--ease);
    }
    .hx-item + .hx-item {
      border-top: 0;
    }
    .hx-item:last-child {
      border-right: 1px solid rgba(15, 35, 64, 0.15);
    }
    .hx-item.is-active {
      flex-basis: calc(100% - (var(--n) - 1) * var(--rail));
    }
    /* Bande fermée : le nom du service en bas, à l'horizontale, sur plusieurs lignes si besoin. */
    .hx-head {
      position: absolute;
      inset: 0;
    }
    .hx-rail {
      height: 100%;
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      padding: 24px 20px;
      transition: color var(--t) ease-out, background-color var(--t) ease-out;
    }
    .hx-rail:hover {
      background: rgba(255, 255, 255, 0.6);
    }
    /* Retour à la ligne normal (sans équilibrage), coupure de mot seulement si un mot ne tient pas. */
    .hx-title {
      font-size: 18px;
      line-height: 1.25;
      text-wrap: wrap;
      hyphens: auto;
    }
    .hx-icon {
      display: none;
    }
    /* Bande ouverte : la photo prend toute la place, le nom passe en grand sur la photo. */
    .is-active .hx-title {
      opacity: 0;
    }
    .hx-media,
    .is-active .hx-media {
      position: absolute;
      inset: 10px;
      height: auto;
      margin: 0;
      transition: opacity var(--t) var(--ease);
    }
    .hx-item:has(.hx-rail:focus-visible) .hx-media {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }
    .hx-copy {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 28px;
    }
    .hx-name {
      display: block;
      font-size: clamp(1.625rem, 1.3rem + 1vw, 2.125rem);
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.024em;
    }
    .hx-summary {
      font-size: 17px;
    }
  }
</style>

<script>
  // Une seule bande ouverte : survol à la souris (bandes côte à côte uniquement : dans l'accordéon,
  // le contenu se décalerait sous la souris), focus clavier ou clic / toucher.
  const root = document.querySelector<HTMLElement>('[data-hx]');
  const sideBySide = matchMedia('(min-width: 1280px)');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-hx-item]')];
    let active = items.findIndex((item) => item.classList.contains('is-active'));
    const open = (index: number) => {
      if (index === active) return;
      const previous = items[active];
      previous?.classList.remove('is-active');
      previous?.querySelector('button')?.setAttribute('aria-expanded', 'false');
      previous?.querySelector('a')?.setAttribute('inert', '');
      const next = items[index];
      next.classList.add('is-active');
      next.querySelector('button')?.setAttribute('aria-expanded', 'true');
      next.querySelector('a')?.removeAttribute('inert');
      active = index;
    };
    items.forEach((item, index) => {
      const button = item.querySelector<HTMLButtonElement>('button')!;
      button.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && sideBySide.matches) open(index);
      });
      button.addEventListener('focus', () => open(index));
      button.addEventListener('click', () => open(index));
    });
  }
</script>
