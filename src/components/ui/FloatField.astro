---
/**
 * Champ de formulaire à libellé flottant : le libellé occupe le champ vide,
 * puis remonte en petit au-dessus de la saisie. Il reste visible et relié au champ.
 * Les options d'une liste déroulante passent par le slot.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  as?: 'input' | 'select' | 'textarea';
  type?: 'text' | 'email' | 'tel';
  required?: boolean;
  autocomplete?: string;
  maxlength?: number;
  rows?: number;
  /** Identifiants supplémentaires pour aria-describedby (compteur…). */
  describedby?: string;
  class?: string;
}

const { id, name, label, as = 'input', type = 'text', required = false, autocomplete, maxlength, rows = 4, describedby, class: className } = Astro.props;
const errorId = `${id}-error`;
const ariaDescribedby = [errorId, describedby].filter(Boolean).join(' ');
---

<div class:list={['fl', as === 'select' && 'fl-select', as === 'textarea' && 'fl-area', className]}>
  {
    as === 'select' ? (
      <select id={id} name={name} required={required} class="fl-control" aria-describedby={ariaDescribedby}>
        <slot />
      </select>
    ) : as === 'textarea' ? (
      <textarea id={id} name={name} required={required} maxlength={maxlength} rows={rows} placeholder=" " class="fl-control" aria-describedby={ariaDescribedby} />
    ) : (
      <input id={id} name={name} type={type} required={required} autocomplete={autocomplete} maxlength={maxlength} placeholder=" " class="fl-control" aria-describedby={ariaDescribedby} />
    )
  }
  <label for={id} class="fl-label">
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  <p id={errorId} class="field-error" hidden></p>
</div>
