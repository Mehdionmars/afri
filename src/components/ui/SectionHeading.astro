---
/** H2 de section, avec un sur-titre facultatif. */
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  /** Couleur du sur-titre. */
  eyebrowClass?: string;
  /** Taille et couleur du H2. */
  titleClass?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  id,
  eyebrowClass = 'text-yellow',
  titleClass = 'text-h2 text-white',
  class: className,
} = Astro.props;
---

<div class:list={['flex flex-col gap-4', className]}>
  {eyebrow && <span class:list={[eyebrowClass.includes('label-mono') ? '' : 'eyebrow', eyebrowClass]}>{eyebrow}</span>}
  <h2 id={id} class:list={['reveal m-0', titleClass]}>{title}</h2>
  <slot />
</div>
