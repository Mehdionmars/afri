---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  index?: number;
}

const { title, text, index = 0 } = Astro.props;
---

<li class="reveal flex items-start gap-4" style={`--i:${index}`}>
  <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-navy text-white">
    <Icon name="check" size={14} stroke={3} />
  </span>
  <span class="flex flex-col gap-1">
    <span class="text-[17px] font-bold">{title}</span>
    <span class="text-[15.5px] leading-[1.6] text-metal-600">{text}</span>
  </span>
</li>
