---
/**
 * 7. Parallaxe : photo d'un camion chargé de conteneurs à gauche et grand triangle en dégradé jaune,
 * qui montent à deux vitesses différentes au scroll (site-motion.ts). À droite, l'accès au guide
 * des conteneurs. Sous 768 px : sans parallaxe.
 */
import PhotoSlot from '../ui/PhotoSlot.astro';
import { routes, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.containers;
---

<section id="conteneurs" class="parallax on-light px-[max(16px,5%)]" aria-labelledby="conteneurs-title" data-parallax>
  <span class="triangle" aria-hidden="true" data-parallax-triangle></span>
  <div class="parallax-grid mx-auto max-w-page">
    <figure class="truck m-0" data-parallax-photo>
      <PhotoSlot
        photo="methode-suivi"
        alt={all.home.containers.photoAlt}
        placeholder=""
        sizes="(min-width: 1024px) 640px, 100vw"
        widths={[480, 800, 1280]}
        imgClass="absolute inset-0 size-full object-cover"
      />
    </figure>
    <div class="parallax-text">
      <p class="label reveal">{all.home.containers.label}</p>
      <h2 id="conteneurs-title" class="reveal m-0 max-w-[14ch] text-h2-lg">{t.title}</h2>
      <p class="reveal m-0 max-w-[40ch] text-lead text-metal-700">{t.lead}</p>
      <a href={routes.containers[lang]} class="link-u reveal self-start text-base font-medium">{all.pages.homeLinks.containers} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .parallax {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(96px, 14vh, 160px);
  }
  .parallax-grid {
    display: grid;
    gap: 48px;
  }
  .truck {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    background: #dde1e6;
  }
  .parallax-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Grand triangle en dégradé jaune vers transparent, derrière la photo. */
  .triangle {
    position: absolute;
    z-index: -1;
    left: 22%;
    top: 30%;
    width: clamp(280px, 46vw, 760px);
    aspect-ratio: 1;
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
    background: linear-gradient(45deg, #ffc342, rgba(255, 195, 66, 0) 75%);
    opacity: 0.8;
    pointer-events: none;
  }
  /* Pendant la parallaxe (souris, classe posée par site-motion.ts) : la photo démarre plus bas ;
     en montant plus vite que la page, elle arrive à sa place. */
  .parallax.is-parallax {
    padding-block: clamp(120px, 18vh, 200px) clamp(40px, 8vh, 96px);
  }
  .is-parallax .truck {
    margin-top: 220px;
  }
  .is-parallax .triangle {
    top: 45%;
  }
  @media (min-width: 1024px) {
    .parallax-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      gap: 96px;
    }
  }
</style>
