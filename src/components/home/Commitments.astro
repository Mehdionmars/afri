---
/**
 * 8. Engagements : deux photos décalées qui montent à deux vitesses (parallaxe, site-motion.ts),
 * puis le label, le titre et les quatre engagements du client en texte long sur deux colonnes.
 */
import PhotoSlot from '../ui/PhotoSlot.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.home.commitments;
const p = all.methodPage;
---

<section id="engagements" class="commit on-light px-[max(16px,5%)]" aria-labelledby="engagements-title" data-commitments>
  <div class="mx-auto max-w-page">
    <div class="commit-photos">
      <figure class="photo photo-a m-0" data-commit-photo-a>
        <PhotoSlot
          photo="mission-industrie"
          alt={t.photoAAlt}
          placeholder=""
          sizes="(min-width: 1024px) 520px, 70vw"
          widths={[480, 800, 1040]}
          imgClass="absolute inset-0 size-full object-cover"
        />
      </figure>
      <figure class="photo photo-b m-0" data-commit-photo-b>
        <PhotoSlot
          photo="mission-agro"
          alt={t.photoBAlt}
          placeholder=""
          sizes="(min-width: 1024px) 420px, 60vw"
          widths={[400, 640, 840]}
          imgClass="absolute inset-0 size-full object-cover"
        />
      </figure>
    </div>

    <div class="commit-text">
      <p class="label reveal">{t.label}</p>
      <h2 id="engagements-title" class="reveal m-0 max-w-[16ch] text-h2-lg">{p.commitmentsTitle}</h2>
      <div class="commit-cols reveal">
        {
          p.commitments.map((item) => (
            <p>
              <strong>{item.title}.</strong> {item.text}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .commit {
    padding-block: clamp(96px, 14vh, 160px);
  }
  .commit-photos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    margin-bottom: clamp(56px, 10vh, 120px);
  }
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: #dde1e6;
  }
  .photo-a {
    grid-column: 1 / 9;
    grid-row: 1;
    aspect-ratio: 4 / 3;
  }
  /* Deuxième photo décalée vers le bas et à droite, par-dessus. */
  .photo-b {
    grid-column: 7 / 13;
    grid-row: 1;
    align-self: end;
    aspect-ratio: 3 / 4;
    margin-bottom: -18%;
    box-shadow: 0 30px 60px -30px rgba(15, 35, 64, 0.45);
  }
  .commit-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .commit-cols {
    columns: 1;
    column-gap: 56px;
    font-size: 17px;
    line-height: 1.65;
    color: #3f4650;
  }
  .commit-cols p {
    margin: 0 0 1em;
    break-inside: avoid;
  }
  .commit-cols strong {
    font-weight: 600;
    color: #0f2340;
  }
  @media (min-width: 768px) {
    .commit-cols {
      columns: 2;
    }
    .photo-a {
      grid-column: 1 / 8;
    }
    .photo-b {
      grid-column: 8 / 12;
      margin-bottom: -24%;
    }
  }
</style>
