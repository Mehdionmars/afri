---
/**
 * 3. Pourquoi nous : deux colonnes. À gauche, le titre, le chiffre clé « 73 % » sur son coup de
 * pinceau jaune, la phrase du client et un bouton à contour arrondi ; à droite, une photo d'équipe.
 * Apparition en fondu au scroll (.reveal, site-motion.ts).
 */
import Button from '../ui/Button.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import { formatPercent, routes, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = useTranslations(lang);
const t = all.why;
// Espace fine insécable avant « % » : le chiffre ne se coupe jamais.
const value = formatPercent(lang, t.stat.value).replace(' ', ' ');
---

<section id="pourquoi" class="people on-light px-[max(16px,5%)]" aria-labelledby="pourquoi-title">
  <div class="people-grid mx-auto max-w-page">
    <div class="people-text">
      <p class="label reveal">{t.eyebrow}</p>
      <h2 id="pourquoi-title" class="reveal m-0 max-w-[14ch] text-h2-xl">{t.title}</h2>

      <figure class="stat reveal m-0">
        <p class="stat-line m-0">
          <span class="stat-value" data-brush>
            <!-- Coup de pinceau jaune derrière le chiffre : bords irréguliers, fin effilochée,
                 quelques traces de poils. Il se peint de gauche à droite à l'arrivée à l'écran. -->
            <svg class="brush" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <defs>
                <filter id="af-brush-rough" x="-4%" y="-12%" width="108%" height="124%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="2" seed="7" result="noise" />
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
                </filter>
                <mask id="af-brush-dry" maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="200">
                  <rect width="600" height="200" fill="#fff" />
                  <g fill="none" stroke="#000" stroke-linecap="round">
                    <path d="M436 68 Q520 62 600 66" stroke-width="2" />
                    <path d="M492 104 Q552 100 600 103" stroke-width="1.6" />
                    <path d="M416 134 Q512 138 598 132" stroke-width="2.4" />
                    <path d="M16 94 Q40 92 66 95" stroke-width="1.6" />
                  </g>
                </mask>
              </defs>
              <g mask="url(#af-brush-dry)">
                <path
                  filter="url(#af-brush-rough)"
                  fill="#FFC342"
                  d="M24 46 C110 30 230 40 350 30 C440 23 520 28 578 36 L594 50 L576 58 L598 72 L580 82 L600 100 L578 110 L596 130 L574 138 L590 156 L556 164 C470 172 360 166 250 174 C160 180 80 178 30 170 C10 166 2 150 8 132 C12 116 2 100 6 82 C8 64 12 52 24 46 Z"
                />
              </g>
            </svg>
            <span class="stat-num">{value}</span>
          </span>
          <span class="stat-copy">
            <span class="stat-text">{t.stat.text}</span>
            <span class="stat-follow">{t.stat.follow}</span>
          </span>
        </p>
        <figcaption class="stat-source">{t.stat.source}</figcaption>
      </figure>

      <div class="reveal">
        <Button href={routes.why[lang]} variant="line" size="lg">{all.pages.homeLinks.why}</Button>
      </div>
    </div>

    <div class="people-photo reveal">
      <PhotoSlot
        photo="services-etude-de-marche"
        alt={all.home.people.photoAlt}
        placeholder={t.photo}
        sizes="(min-width: 1024px) 560px, 100vw"
        widths={[480, 800, 1200]}
        imgClass="absolute inset-0 size-full object-cover"
        placeholderClass="placeholder-photo absolute inset-0 text-[15px] text-metal-700"
      />
    </div>
  </div>
</section>

<style>
  .people {
    padding-block: clamp(96px, 14vh, 160px);
  }
  .people-grid {
    display: grid;
    gap: 56px;
  }
  .people-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .people-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    background: #dde1e6;
  }
  @media (min-width: 1024px) {
    .people-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: 96px;
    }
  }

  /* ---------- Chiffre clé sur son coup de pinceau ---------- */
  .stat-line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 14px 24px;
  }
  .stat-value {
    position: relative;
    isolation: isolate;
    display: inline-block;
    padding: 0 0.04em;
    font-size: clamp(4rem, 2.6rem + 5vw, 7.5rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: #0f2340;
  }
  .brush {
    position: absolute;
    z-index: -1;
    left: -0.1em;
    top: -0.06em;
    width: calc(100% + 0.18em);
    height: calc(100% + 0.2em);
    overflow: visible;
    rotate: -1.5deg;
    pointer-events: none;
  }
  /* Avec JavaScript, le pinceau passe de gauche à droite quand le chiffre arrive à l'écran. */
  :global(html.js) .brush {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
  }
  :global(html.js) .is-painted .brush {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .brush {
      clip-path: none;
      transition: none;
    }
  }
  .stat-copy {
    display: flex;
    flex: 1 1 200px;
    flex-direction: column;
    gap: 6px;
    max-width: 280px;
  }
  .stat-text {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
  }
  .stat-follow {
    font-size: 16px;
    line-height: 1.45;
    color: #3f4650;
  }
  .stat-source {
    margin-top: 18px;
    font-size: 13px;
    color: #5e6670;
  }
</style>

<script>
  // Le pinceau passe une fois, quand le chiffre est bien visible.
  const stat = document.querySelector<HTMLElement>('[data-brush]');
  if (stat) {
    if (!('IntersectionObserver' in window)) {
      stat.classList.add('is-painted');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          stat.classList.add('is-painted');
          observer.disconnect();
        },
        { threshold: 0.6 },
      );
      observer.observe(stat);
    }
  }
</script>
