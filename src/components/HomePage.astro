---
/**
 * Accueil, dans l'ordre : intro, chiffres clés, pourquoi nous, bandeau des atouts, méthode,
 * services, conteneurs (parallaxe), engagements, puis la demande de devis.
 * Animations : src/scripts/site-motion.ts (GSAP + ScrollTrigger + Lenis).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteRail from './layout/RouteRail.astro';
import Intro from './home/Intro.astro';
import KeyFigures from './home/KeyFigures.astro';
import People from './home/People.astro';
import ValuesBand from './home/ValuesBand.astro';
import MethodPinned from './home/MethodPinned.astro';
import ServicesList from './home/ServicesList.astro';
import ParallaxImages from './home/ParallaxImages.astro';
import Commitments from './home/Commitments.astro';
import Contact from './sections/Contact.astro';
import { routes, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} alternates={routes.home} isHome>
  <RouteRail lang={lang} />
  <Intro lang={lang} />
  <KeyFigures lang={lang} />
  <People lang={lang} />
  <ValuesBand lang={lang} />
  <MethodPinned lang={lang} />
  <ServicesList lang={lang} />
  <ParallaxImages lang={lang} />
  <Commitments lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
