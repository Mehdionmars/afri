---
/**
 * Sélecteur de conteneur en 3D : le visiteur choisit un format, la caisse s'allonge
 * ou se rehausse en direct et les chiffres défilent. On peut aussi faire tourner le conteneur :
 * glissé à la souris ou au doigt (avec un peu d'inertie au lâcher), flèches du clavier,
 * double-clic pour revenir à l'angle de départ. Page Conteneurs. Une seule instance par page.
 */
import Container3D from '../three/Container3D.astro';
import ContainerScene from '../three/ContainerScene.astro';
import { formatNumber, useTranslations, type Lang } from '../../i18n/utils';

export interface PickerSpec {
  id: string;
  /** Libellé court du bouton (« 20' DC »). */
  label: string;
  name: string;
  type: string;
  lengthM: number;
  widthM: number;
  heightM: number;
  volumeM3: number;
  payloadKg: number;
  palletsEuro: number;
}

interface Props {
  lang: Lang;
  specs: PickerSpec[];
  class?: string;
}

const { lang, specs, class: className } = Astro.props;
const t = useTranslations(lang).containers;
const first = specs[0];
const SCALE = 32; // px par mètre dans la scène

const fields = [
  { key: 'lengthM', label: t.length, digits: 2, unit: 'm' },
  { key: 'widthM', label: t.width, digits: 2, unit: 'm' },
  { key: 'heightM', label: t.height, digits: 2, unit: 'm' },
  { key: 'volumeM3', label: t.volume, digits: 1, unit: 'm³', approx: true },
  { key: 'payloadKg', label: t.payload, digits: 0, unit: 'kg', approx: true },
  { key: 'palletsEuro', label: t.pallets, digits: 0, unit: '' },
] as const;

const fmt = (value: number, digits: number, unit: string, approx = false) =>
  `${approx ? '≈ ' : ''}${formatNumber(lang, value, digits)}${unit ? ` ${unit}` : ''}`;

const payload = JSON.stringify({ lang, scale: SCALE, specs });
---

<div class:list={['grid items-stretch gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-12', className]} data-picker data-specs={payload}>
  <div
    class="stage reveal"
    data-anim
    data-stage
    tabindex="0"
    role="slider"
    aria-label={t.rotateLabel}
    aria-valuemin="0"
    aria-valuemax="359"
    aria-valuenow="326"
    aria-valuetext={t.rotateValue.replace('{deg}', '326')}
    data-value-template={t.rotateValue}
  >
    <span class="hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M3 12h18"></path></svg>
      {t.dragHint}
    </span>
    <div class="shadow" aria-hidden="true" data-shadow></div>
    <ContainerScene animation="none" startAngle={-34} tilt={-16} perspective={1600} pausable={false} class="absolute inset-0" rigClass="picker-rig">
      <Container3D length={first.lengthM} width={first.widthM} height={first.heightM} color="yellow" scale={SCALE} class="morph picker-box" />
    </ContainerScene>
    <span class="label-mono stage-ruler" aria-hidden="true" data-ruler>L {formatNumber(lang, first.lengthM, 2)} m</span>
  </div>

  <div class="flex flex-col gap-7">
    <div class="segmented" role="radiogroup" aria-label={t.picker}>
      {
        specs.map((spec, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-choice={spec.id}>
            {spec.label}
          </button>
        ))
      }
    </div>

    <div class="flex flex-col gap-1.5">
      <h3 class="m-0 text-h3-lg" data-name>{first.name}</h3>
      <p class="m-0 text-[15px] text-metal-600" data-type>{first.type}</p>
    </div>

    <dl class="m-0 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-navy/12 pt-6" aria-live="polite">
      {
        fields.map((field) => (
          <div class="flex flex-col gap-1">
            <dt class="label-mono text-metal-600">{field.label}</dt>
            <dd class="m-0 text-[clamp(1.375rem,1.2rem+0.6vw,1.75rem)] font-medium tabular-nums tracking-[-0.02em]" data-field={field.key} data-digits={field.digits} data-unit={field.unit} data-approx={'approx' in field ? '1' : undefined}>
              {fmt(first[field.key], field.digits, field.unit, 'approx' in field)}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="m-0 text-[13px] text-metal-600">{t.detailsNote}</p>
  </div>
</div>

<style>
  .stage {
    --rig-s: 0.6;
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-radius: 20px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(15, 35, 64, 0.08);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .stage.is-dragging {
    cursor: grabbing;
  }
  .stage:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  /* Indication discrète, qui s'efface dès la première rotation. */
  .hint {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #5e6670;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }
  .stage.was-turned .hint {
    opacity: 0;
  }
  @media (min-width: 1024px) {
    .stage {
      min-height: 440px;
    }
  }
  .shadow {
    position: absolute;
    left: 50%;
    top: 62%;
    width: calc(var(--sw, 240px) * var(--rig-s));
    height: 34px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(15, 35, 64, 0.28), transparent);
    transition: width 0.7s var(--ease-out);
  }
  .stage.is-dragging .shadow {
    transition: none;
  }
  .stage-ruler {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    color: #5e6670;
  }
  /* `translate` et `scale` se cumulent avec la rotation de la scène sans la remplacer. */
  :global(.picker-rig) {
    translate: 0 6%;
    scale: var(--rig-s);
  }
  @media (min-width: 480px) {
    .stage {
      --rig-s: 0.78;
    }
  }
  @media (min-width: 1024px) {
    .stage {
      --rig-s: 1;
    }
  }
  /* Léger reflet qui passe sur la caisse : la touche vivante de la section. */
  .stage::after {
    content: '';
    position: absolute;
    inset: -20%;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.3) 50%, transparent 58%);
    mix-blend-mode: soft-light;
    animation: afSheen 9s ease-in-out -3s infinite;
  }
  @keyframes afSheen {
    0%, 60% { translate: -60% 0; }
    100% { translate: 60% 0; }
  }

  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    padding: 4px;
    gap: 4px;
    border-radius: 24px;
    background: #eef0f2;
    box-shadow: inset 0 0 0 1px rgba(15, 35, 64, 0.12);
  }
  .segmented button {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #3F4650;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .segmented button:hover {
    color: #0b0b0c;
    background: rgba(255, 255, 255, 0.8);
  }
  .segmented button[aria-checked='true'] {
    background: #0b0b0c;
    color: #fff;
  }
</style>

<script>
  interface Spec {
    id: string;
    name: string;
    type: string;
    lengthM: number;
    widthM: number;
    heightM: number;
    volumeM3: number;
    payloadKg: number;
    palletsEuro: number;
  }

  const picker = document.querySelector<HTMLElement>('[data-picker]');
  if (picker) {
    const data = JSON.parse(picker.dataset.specs!) as { lang: string; scale: number; specs: Spec[] };
    const locale = data.lang === 'fr' ? 'fr-FR' : 'en-GB';
    const box = picker.querySelector<HTMLElement>('.picker-box')!;
    const shadow = picker.querySelector<HTMLElement>('[data-shadow]')!;
    const choices = [...picker.querySelectorAll<HTMLButtonElement>('[data-choice]')];
    const fields = [...picker.querySelectorAll<HTMLElement>('[data-field]')];
    const name = picker.querySelector<HTMLElement>('[data-name]')!;
    const typeEl = picker.querySelector<HTMLElement>('[data-type]')!;
    const ruler = picker.querySelector<HTMLElement>('[data-ruler]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const stage = picker.querySelector<HTMLElement>('[data-stage]')!;
    const rig = picker.querySelector<HTMLElement>('.picker-rig')!;
    let current = data.specs[0];
    let rollId = 0;

    const format = (value: number, digits: number, unit: string, approx: boolean) =>
      `${approx ? '≈ ' : ''}${new Intl.NumberFormat(locale, { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(value)}${unit ? ` ${unit}` : ''}`;

    const px = (m: number) => `${Math.round(m * data.scale * 10) / 10}px`;

    function render(spec: Spec, t: number, from: Spec) {
      for (const el of fields) {
        const key = el.dataset.field as keyof Spec;
        const a = from[key] as number;
        const b = spec[key] as number;
        el.textContent = format(a + (b - a) * t, Number(el.dataset.digits), el.dataset.unit ?? '', !!el.dataset.approx);
      }
    }

    function select(spec: Spec) {
      if (spec.id === current.id) return;
      const from = current;
      current = spec;
      choices.forEach((button) => {
        const on = button.dataset.choice === spec.id;
        button.setAttribute('aria-checked', String(on));
        button.tabIndex = on ? 0 : -1;
      });
      box.style.setProperty('--l', px(spec.lengthM));
      box.style.setProperty('--w', px(spec.widthM));
      box.style.setProperty('--h', px(spec.heightM));
      applyAngle();
      name.textContent = spec.name;
      typeEl.textContent = spec.type;
      ruler.textContent = `L ${new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(spec.lengthM)} m`;

      // Les chiffres défilent jusqu'à leur nouvelle valeur (instantané avec mouvement réduit).
      const id = ++rollId;
      if (reduce.matches) return render(spec, 1, from);
      const start = performance.now();
      const step = (now: number) => {
        if (id !== rollId) return;
        const t = Math.min(1, (now - start) / 600);
        render(spec, 1 - Math.pow(1 - t, 3), from);
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // ---------- Rotation : glissé, inertie, clavier ----------
    const START = { yaw: -34, pitch: -16 };
    const PITCH_MIN = -42; // vue plongeante maximale
    const PITCH_MAX = 0; // jamais sous le sol
    let yaw = START.yaw;
    let pitch = START.pitch;
    let velocity = 0;
    let spin = 0;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    /** Applique l'angle, ajuste l'ombre à l'empreinte au sol et annonce l'angle aux lecteurs d'écran. */
    function applyAngle() {
      rig.style.transform = `rotateX(${pitch.toFixed(2)}deg) rotateY(${yaw.toFixed(2)}deg)`;
      const r = (yaw * Math.PI) / 180;
      const foot = (current.lengthM * Math.abs(Math.cos(r)) + current.widthM * Math.abs(Math.sin(r))) * data.scale * 0.95;
      shadow.style.setProperty('--sw', `${Math.round(foot)}px`);
      const deg = Math.round(((yaw % 360) + 360) % 360);
      stage.setAttribute('aria-valuenow', String(deg));
      stage.setAttribute('aria-valuetext', (stage.dataset.valueTemplate ?? '{deg}').replace('{deg}', String(deg)));
    }
    const stopSpin = () => cancelAnimationFrame(spin);

    let drag: { id: number; x: number; y: number; t: number; mouse: boolean } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      stopSpin();
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now(), mouse: e.pointerType !== 'touch' };
      velocity = 0;
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {}
      stage.classList.add('is-dragging');
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      const now = performance.now();
      const step = dx * 0.45;
      yaw += step;
      // Au doigt, le glissé vertical fait défiler la page (touch-action: pan-y) : seule la souris incline.
      if (drag.mouse) pitch = clamp(pitch - dy * 0.3, PITCH_MIN, PITCH_MAX);
      velocity = step / Math.max(1, now - drag.t) * 16;
      drag.x = e.clientX;
      drag.y = e.clientY;
      drag.t = now;
      if (Math.abs(dx) + Math.abs(dy) > 0) stage.classList.add('was-turned');
      applyAngle();
    });
    const release = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      drag = null;
      stage.classList.remove('is-dragging');
      // Un peu d'inertie au lâcher, sauf avec « mouvement réduit ».
      if (reduce.matches || Math.abs(velocity) < 0.2) return;
      const glide = () => {
        velocity *= 0.93;
        yaw += velocity;
        applyAngle();
        if (Math.abs(velocity) > 0.05) spin = requestAnimationFrame(glide);
      };
      spin = requestAnimationFrame(glide);
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    // Clavier : flèches gauche/droite pour tourner, haut/bas pour incliner, Début pour revenir.
    stage.addEventListener('keydown', (e) => {
      const keys: Record<string, () => void> = {
        ArrowLeft: () => (yaw -= 15),
        ArrowRight: () => (yaw += 15),
        ArrowUp: () => (pitch = clamp(pitch - 5, PITCH_MIN, PITCH_MAX)),
        ArrowDown: () => (pitch = clamp(pitch + 5, PITCH_MIN, PITCH_MAX)),
        Home: () => ((yaw = START.yaw), (pitch = START.pitch)),
      };
      if (!keys[e.key]) return;
      e.preventDefault();
      stopSpin();
      keys[e.key]();
      stage.classList.add('was-turned');
      applyAngle();
    });

    // Double-clic : retour en douceur à l'angle de départ.
    stage.addEventListener('dblclick', () => {
      stopSpin();
      const from = { yaw, pitch };
      // Chemin le plus court vers l'angle de départ.
      const target = START.yaw + Math.round((yaw - START.yaw) / 360) * 360;
      if (reduce.matches) {
        yaw = target;
        pitch = START.pitch;
        return applyAngle();
      }
      const t0 = performance.now();
      const back = (now: number) => {
        const k = Math.min(1, (now - t0) / 600);
        const ease = 1 - Math.pow(1 - k, 3);
        yaw = from.yaw + (target - from.yaw) * ease;
        pitch = from.pitch + (START.pitch - from.pitch) * ease;
        applyAngle();
        if (k < 1) spin = requestAnimationFrame(back);
      };
      spin = requestAnimationFrame(back);
    });

    applyAngle();
    choices.forEach((button, i) => {
      button.addEventListener('click', () => select(data.specs[i]));
      button.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (i + delta + choices.length) % choices.length;
        choices[next].focus();
        select(data.specs[next]);
      });
    });
  }
</script>
